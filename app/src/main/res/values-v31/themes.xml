<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Тема для splash screen для Android 12+ -->
    <style name="Theme.Voxera.Splash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="postSplashScreenTheme">@style/Theme.Voxera</item>
        <!-- Для Android 12+ - используем ic_x_glow с сиянием внутри круга -->
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_x_glow_with_glow</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
